-        
+
         <activity
             android:name=".MainActivity"
             android:exported="true"
+            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
+            android:launchMode="singleTask"
             android:theme="@style/Theme.Postkeeper"
             android:windowSoftInputMode="adjustResize">
-            
+
             <intent-filter>
                 <action android:name="android.intent.action.MAIN" />
                 <category android:name="android.intent.category.LAUNCHER" />
             </intent-filter>
-            
-            <!-- Instagram Share Intent -->
-            <intent-filter>
-                <action android:name="android.intent.action.SEND" />
-                <category android:name="android.intent.category.DEFAULT" />
-                <data android:mimeType="text/plain" />
-            </intent-filter>
-            
-            <!-- X/Twitter Share Intent -->
+
+            <!-- Share Intent for text links (Instagram / X posts & stories) -->
             <intent-filter>
                 <action android:name="android.intent.action.SEND" />
                 <category android:name="android.intent.category.DEFAULT" />
                 <data android:mimeType="text/plain" />
             </intent-filter>
-            
+
         </activity>
-        
+
     </application>
 
 </manifest>
diff --git a/gradle.properties b/gradle.properties
index 6b4b1cf..2a9b697 100644
--- a/gradle.properties
+++ b/gradle.properties
@@ -1,6 +1,7 @@
